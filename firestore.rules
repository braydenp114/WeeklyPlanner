rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      // Allow read/update/delete if the user owns the task
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      
      // Allow create if the user is authenticated and setting themselves as the owner
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
